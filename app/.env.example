# Copier ce fichier en .env (ignoré par git) et renseigner les valeurs.

# Compte Gmail utilisé pour envoyer les codes OTP de connexion.
# MAIL_PASSWORD = "mot de passe d'application" Gmail (16 caractères), pas le mot de passe du compte.
MAIL_USERNAME=
MAIL_PASSWORD=

# Mot de passe root MariaDB (défaut : root)
DB_PASSWORD=root

# Clé de signature JWT (laisser vide = clé de dev par défaut)
JWT_SECRET=
